# ---------------------------------------------------------------------------
# NexiLink Downloader Bot — example environment file
# Copy this to `.env` for local development. On Railway, set these under
# the project's "Variables" tab instead.
# ---------------------------------------------------------------------------

# Telegram API credentials (from https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Main bot token (from @BotFather)
BOT_TOKEN=123456:your-bot-token-here

# Optional Telegram user session string (for bigger upload limits with a
# Premium account). Generate with `python generate_session.py`. Leave
# empty to run purely as a bot with BOT_TOKEN.
SESSION_STRING=

# Numeric Telegram ID of the bot owner (get yours from @userinfobot).
OWNER_ID=123456789

# ---------------------------------------------------------------------------
# NexiLink Manager Bot (second, admin-only bot) — runs in the SAME
# deployment as the main bot, no extra Railway service required.
# ---------------------------------------------------------------------------
# Create a second bot with @BotFather and put its token here to enable
# the Manager Bot. Leave empty to disable it entirely.
MANAGER_BOT_TOKEN=

# Extra admin IDs (comma separated) allowed to use the Manager Bot besides
# OWNER_ID, e.g. "111111111,222222222".
MANAGER_ADMIN_IDS=

# Chat that receives logs/reports from the Manager Bot. Defaults to OWNER_ID.
MANAGER_CHAT_ID=

# Default report interval in minutes (0 = immediately). Can be changed at
# runtime from the Manager Bot with /interval; the value is persisted.
DEFAULT_REPORT_INTERVAL_MINUTES=10

# ---------------------------------------------------------------------------
# Limits & paths
# ---------------------------------------------------------------------------
# Maximum allowed file size in bytes (default: 2 GB)
MAX_FILE_SIZE=2147483648

# Temporary download directory
DOWNLOAD_PATH=/tmp/downloads

# SQLite database file path
DB_PATH=bot_data.db

# Per-user request rate limit (requests allowed within the time window)
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60

# Maximum concurrent downloads across the whole bot (keep low on Railway's
# Free Plan; 2-3 is recommended)
MAX_CONCURRENT_DOWNLOADS=2

# Items above this count in an Instagram carousel / SoundCloud playlist are
# zipped into a single archive instead of being sent one by one.
ZIP_THRESHOLD_ITEMS=6

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Parallel upload (Telegram upload speed) — see fast_upload.py
# ---------------------------------------------------------------------------
UPLOAD_MAX_CONNECTIONS=6
UPLOAD_PARALLEL_MIN_MB=10

# ---------------------------------------------------------------------------
# yt-dlp / generic downloader
# ---------------------------------------------------------------------------
# YouTube cookies in Netscape format (the full cookies.txt content, not a
# path). Needed to fix "Sign in to confirm you're not a bot" and to
# download age/member-restricted videos. See README.md for how to export.
YOUTUBE_COOKIES=

# Optional extra cookies for other platforms (Twitter/X, PornHub, ...) in
# the same Netscape format.
EXTRA_COOKIES=

# Optional cookies specifically for Instagram (improves reliability for
# rate-limited/borderline posts).
INSTAGRAM_COOKIES=

# Override the order of YouTube player clients yt-dlp tries (comma
# separated, e.g. tv,web_safari,web).
YOUTUBE_PLAYER_CLIENTS=

# Advanced downloader/network tuning
DOWNLOADER_SOCKET_TIMEOUT=30
DOWNLOADER_RETRIES=5
DOWNLOADER_FRAGMENT_RETRIES=10
DOWNLOADER_EXTRACTOR_RETRIES=3
DOWNLOADER_HTTP_CHUNK_MB=10
CONCURRENT_FRAGMENT_DOWNLOADS=4
DOWNLOADER_OUTER_RETRIES=2

# ---------------------------------------------------------------------------
# SoundCloud
# ---------------------------------------------------------------------------
# Maximum number of tracks processed from a single playlist/set
MAX_PLAYLIST_TRACKS=100

# ---------------------------------------------------------------------------
# PornHub (optional, fully isolated workflow — disable with false)
# ---------------------------------------------------------------------------
PORNHUB_ENABLED=true
# After every successful PornHub download, a notification (user id/
# username, video title, status and time) is sent to OWNER_ID.
PORNHUB_NOTIFY_ADMIN=true

# ---------------------------------------------------------------------------
# Pinterest
# ---------------------------------------------------------------------------
PINTEREST_ENABLED=true

# ---------------------------------------------------------------------------
# Instagram
# ---------------------------------------------------------------------------
INSTAGRAM_ENABLED=true

# ---------------------------------------------------------------------------
# Inline mode
# ---------------------------------------------------------------------------
# Remember to also enable inline mode for the bot via @BotFather
# (/setinline), otherwise Telegram will not deliver inline queries to it.
INLINE_MODE_ENABLED=true
